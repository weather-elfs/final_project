PM1_API_KEY=PM1_공공데이터포털_크롤링키
PM1_SOURCE_TIMEZONE=+09:00
PM1_SYNC_LAG_HOURS=1

# SSH 터널을 별도 터미널에서 먼저 실행한 뒤 수집기를 실행한다.
# 3000은 서버 Docker의 호스트 포트(3000 -> PostgreSQL 5432)다.
# ssh -N -L 5433:127.0.0.1:3000 root@<NAVER_CLOUD_PUBLIC_IP>
DB_CONNECTION_MODE=ssh-tunnel
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=
# ssh-tunnel 모드에서는 SSH가 암호화하므로 DB_SSLROOTCERT를 비워 둔다.
DB_SSLROOTCERT=

DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
DB_INGEST_USER=
DB_INGEST_PASSWORD=
DB_EXPORT_USER=
DB_EXPORT_PASSWORD=
